{
  "name": "nudge-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/mcp",
    "packages/sidecar",
    "apps/popup"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "nudge": "node packages/cli/src/main.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/popup/tsconfig.json",
    "test": "node --test --test-concurrency=4 \"packages/*/test/*.test.ts\" \"apps/*/test/*.test.ts\" \"tools/test/*.test.ts\"",
    "popup:build": "node --disable-warning=ExperimentalWarning apps/popup/build.ts",
    "bench": "node tools/bench.ts",
    "eval": "node tools/eval.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
